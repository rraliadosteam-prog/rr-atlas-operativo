{
  "name": "rr-atlas-operativo",
  "version": "4.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:legacy": "node scripts/build.mjs",
    "build:rust": "bash scripts/build-rust-web.sh",
    "test": "node --test \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\" scripts/test-persistence.mjs",
    "preview:local": "node scripts/build.mjs --local && python3 -m http.server 4175 --bind 127.0.0.1 --directory dist",
    "audit:visual": "node scripts/audit-visual.mjs",
    "audit:ux": "node scripts/auditoria-ux-fusion.mjs",
    "lint:bpmn": "node scripts/validate-bpmn.mjs",
    "semillas:contenido": "node scripts/pase-contenido-semillas.mjs",
    "semillas:estado": "node scripts/actualizar-estado-semillas.mjs",
    "fixture:flujos": "node scripts/generar-fixture-flujos.mjs",
    "carriles:extraer": "node scripts/extraer-carriles.mjs",
    "check": "for f in $(find src scripts -name '*.mjs' -print); do node --check \"$f\" || exit 1; done; npm test && npm run build && npm run verificar:cierre:final",
    "verificar:bpmn-edicion": "node scripts/verificar-bpmn-edicion.mjs",
    "verificar:guia": "node scripts/verificar-guia-bpmn.mjs",
    "verificar:pantalla": "node scripts/verificar-pantalla-completa.mjs",
    "verificar:dividido": "node scripts/verificar-dividido.mjs",
    "verificar:cierre": "node scripts/verificar-cierre.mjs",
    "verificar:tactil": "node scripts/verificar-tactil.mjs",
    "verificar:cierre:final": "node scripts/verificar-cierre-final.mjs"
  },
  "dependencies": {
    "bpmn-js": "18.31.1",
    "bpmn-moddle": "10.3.1",
    "bpmnlint": "12.0.0"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "playwright-core": "^1.55.0"
  }
}
